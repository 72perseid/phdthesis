# CQ6  Which statements are interpretations rather than observations, and on what basis?
PREFIX crm:        <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/>
PREFIX crmsci:     <http://www.cidoc-crm.org/extensions/crmsci/>
PREFIX rdfs:       <http://www.w3.org/2000/01/rdf-schema#>
PREFIX kst:        <https://example.org/kst45/vocab/>
PREFIX type:       <https://example.org/kst45/type/>
SELECT ?about ?interpretation ?basis (MIN(?pg) AS ?page) WHERE {
  ?i a crm:E13_Attribute_Assignment ; crm:P2_has_type type:interpretation ;
     crm:P140_assigned_attribute_to/rdfs:label ?about ; rdfs:label ?interpretation .
  OPTIONAL { ?i crm:P3_has_note ?basis }
  OPTIONAL { ?i kst:sourcePage ?pg }
} GROUP BY ?about ?interpretation ?basis ORDER BY ?page ?about
