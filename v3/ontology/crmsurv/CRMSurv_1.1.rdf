    <rdfs:range rdf:resource="https://takin.solutions/ontologies/CRMsurv/U6_Material_Sample"/>
    <rdfs:comment xml:lang="en">This property relates an instance of U2 Survey Collection Activity  to the U6 Material Sample Unit that it collected. It describes the act of collecting a set of objects from a Surface Survey Unit according to a given procedure, as part of a Survey Process Unit.</rdfs:comment>
    <rdfs:label xml:lang="en">collected</rdfs:label>
